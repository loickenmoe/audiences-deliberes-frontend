# Local frontend configuration - copy to `.env.local` and adjust.
# `.env.local` is git-ignored. NO real secret may be committed (see RF-04).

# Backend API base URL, prefix included. The backend listens on 8080 (contract REF-07).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Real-time SockJS/STOMP channel.
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# Authentication (Keycloak, OIDC)
# Session encryption key. Generate a distinct value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true
KEYCLOAK_ISSUER=http://localhost:8081/realms/audiences-realm
KEYCLOAK_CLIENT_ID=audiences-api
# CONFIDENTIAL client: the secret is mandatory (without it Keycloak answers
# `unauthorized_client`). Value in keycloak/audiences-realm.json of the backend repository.
# Server-side only: never exposed to the browser, never committed.
KEYCLOAK_CLIENT_SECRET=
