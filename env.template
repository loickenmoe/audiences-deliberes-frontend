# Configuration locale du frontend — copier en `.env.local` et adapter.
# `.env.local` est ignoré par git. AUCUN secret réel ne doit être versionné (cf. RF-04).

# ─── Backend ───────────────────────────────────────────────────────────────
# Base de l'API, préfixe inclus. Le backend écoute sur 8080 (contrat REF-07).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Canal temps réel SockJS/STOMP, consommé à partir du jalon F14.
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# ─── Authentification (renseigné au jalon F2) ──────────────────────────────
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=                       # openssl rand -base64 32
# KEYCLOAK_ISSUER=http://localhost:8081/realms/audiences-realm
# KEYCLOAK_CLIENT_ID=audiences-api
# KEYCLOAK_CLIENT_SECRET=                # client confidentiel : secret OBLIGATOIRE.
#                                        # Valeur dans keycloak/audiences-realm.json du backend.
#                                        # Reste côté serveur Next.js, jamais exposé au navigateur.
